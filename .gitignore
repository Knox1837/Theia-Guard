# Raw / downloaded DARPA data (large, re-downloadable)
data/raw/*

# Converted graphs (regenerable from raw + parser)
data/processed/clean/*.gexf
data/processed/attack/*.gexf

# Ground truth PDFs (large, redistributable but not needed in repo)
data/ground_truth/*.pdf

# Trained models (regenerable; keep at most one sample if you want)
ml/models/*.joblib
ml/models/*.json

# Tuning recommendations (regenerable via ml/tune_if.py, tune_lof.py, tune_dbscan.py)
ml/if_best_params.json
ml/lof_best_params.json
ml/dbscan_best_params.json

# Evaluation outputs
results.json
results/
*.results.json
results_3session.json

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# Python
__pycache__/
*.pyc
*.egg-info/

# Editor / env
.vscode/
.idea/
.env
.env.*

output/
scripts/